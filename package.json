{
  "name": "story-engine",
  "version": "0.1.0",
  "description": "A story-agnostic text adventure engine in the style of the late-1970s mainframe adventures. Worlds are loaded from content packs.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "play": "node src/cli/main.ts play",
    "validate": "node src/cli/main.ts validate",
    "build": "node scripts/build.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}

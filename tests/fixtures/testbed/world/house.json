{
  "_comment": "Indoor rooms. Keys starting with _ are ignored.",
  "rooms": {
    "hall": {
      "name": "Hall",
      "description": [
        "A square hall with a flagstone floor. A door leads north, the kitchen is east, an archway opens west to the garden and stone steps go down. A trapdoor is set in the ceiling.",
        {
          "if": {
            "obj": "ladder",
            "in": "hall"
          },
          "text": "A ladder reaches up to the trapdoor."
        }
      ],
      "firstVisit": "@hall-first",
      "exits": {
        "north": {
          "to": "study",
          "door": "study-door"
        },
        "east": "kitchen",
        "west": "garden",
        "down": "cellar",
        "up": {
          "to": "attic",
          "if": {
            "obj": "ladder",
            "in": "hall"
          },
          "else": "The trapdoor is too high to reach."
        },
        "south": {
          "say": "The front door is barred from outside."
        }
      }
    },
    "kitchen": {
      "name": "Kitchen",
      "description": [
        "A narrow kitchen. A table stands by the wall.",
        {
          "if": {
            "var": "cupboard.open"
          },
          "text": "The cupboard hangs open.",
          "else": "The cupboard is shut."
        }
      ],
      "exits": {
        "west": "hall"
      },
      "noExit": "The only way out of the kitchen is west."
    },
    "study": {
      "name": "Study",
      "description": "A small study with a desk under the window.",
      "exits": {
        "south": {
          "to": "hall",
          "door": "study-door"
        }
      }
    },
    "cellar": {
      "name": "Cellar",
      "description": "A low cellar that smells of earth.",
      "dark": true,
      "exits": {
        "up": "hall"
      }
    },
    "attic": {
      "name": "Attic",
      "description": "Dust and rafters.",
      "exits": {
        "down": "hall"
      }
    }
  },
  "objects": {
    "study-door": {
      "name": "study door",
